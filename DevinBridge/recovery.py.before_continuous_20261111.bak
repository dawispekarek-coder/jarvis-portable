"""Autonomous failure diagnosis + verified recovery (FAILURE_RECOVERY).

Pipeline per FAILED production task:

    DETECTED → DIAGNOSED → RECOVERY_DISPATCHED → VERIFIED_RECOVERED
             ↘ WAITING_HUMAN (permission/evidence/scope needed)
             ↘ ESCALATED (recovery attempts exhausted → ntfy, human)

Rules that keep this honest:
  * A dependency is satisfied ONLY by COMPLETE or VERIFIED_RECOVERED —
    never by editing FAILED→COMPLETE. The original FAILED transition
    stays in history; recovery is a supersession recorded on the task.
  * Recovery re-runs the ORIGINAL acceptance checks verbatim — the fix
    must make the real test pass, not relax it.
  * Corrective tasks are bounded: ≤MAX_RECOVERY_ATTEMPTS per parent,
    cooldown via not_before, one writer per worktree (existing
    coordinator guarantee), idempotent by recovery fingerprint.
  * No grant → no dispatch: recovery only runs inside the parent's own
    authorized worktree + an existing owner authorization file for it.
"""
from __future__ import annotations

import hashlib
import re
import time
from pathlib import Path

from .bridge_store import (atomic_write_json, file_lock, prompt_sha,
                           read_json, utcnow)

STATE_FILE = "recovery_state.json"
MAX_RECOVERY_ATTEMPTS = 2
RECOVERY_COOLDOWN_S = 120.0

_PATH_RE = re.compile(r"((?:tests|tools|src|DB|docs)[/\\][\w./\\-]+)")
# Owner-protected files: never listed as editable recovery paths, and
# explicitly flagged in the corrective prompt if the task mentions them.
FORBIDDEN_PATHS = {"db/forever/quest.lua", "db/forever/xp.lua"}
_ASSERT_RE = re.compile(r"(AssertionError|FAIL:|FAILED|expected .+"
                        r"(?:but |got |was |actual).+)", re.I)


def _load(path: Path) -> dict:
    d = read_json(path, {})
    d.setdefault("recoveries", {})
    return d


def _save(path: Path, d: dict) -> None:
    atomic_write_json(path, d)


def _auth_for(coord, worktree: str) -> dict | None:
    """Owner authorization file covering this worktree (the FR-style
    scoped grant). Recovery inherits it — we never mint new grants.
    Only LIVE grants at autonomy_scope/ root count — a file moved to
    historical_grants/ is expired by the owner's own action."""
    scope = coord.root / "autonomy_scope"
    if not scope.is_dir():
        return None
    wt = str(Path(worktree).resolve()).casefold()
    for f in scope.glob("*AUTHORIZATION*.json"):
        d = read_json(f, {})
        if not d:
            continue
        if str(Path(d.get("worktree", "")).resolve()).casefold() == wt:
            return d
    return None


RECOVERY_KIND = "repair-small"


def check_grant(auth: dict | None, task: dict, cls: dict) -> tuple:
    """Enforce EVERY grant field — a grant that only names the worktree
    is NOT enough. Returns (ok, reason). All fields fail-closed."""
    if not auth:
        return False, "no owner authorization file for worktree"
    exp = float(auth.get("expires_epoch") or 0)
    if exp <= time.time():
        return False, "authorization expired"
    # parent task IDs the grant explicitly covers
    allowed = set(auth.get("allowed_task_ids") or []) | set(
        auth.get("recovery_parents") or [])
    if task["id"] not in allowed:
        return False, f"parent {task['id']} not in allowed_task_ids"
    kinds = set(auth.get("kinds") or auth.get("allowed_kinds") or [])
    if RECOVERY_KIND not in kinds:
        return False, f"kind '{RECOVERY_KIND}' not granted"
    # corrective paths must ALL stay inside the granted paths
    allowed_paths = [p.replace("\\", "/").rstrip("/")
                     for p in (auth.get("allowed_paths") or [])]
    if allowed_paths:
        bad = [p for p in cls.get("paths") or []
               if not any(p == a or p.startswith(a + "/")
                          for a in allowed_paths)]
        if bad:
            return False, f"paths outside grant: {bad[:3]}"
    else:
        return False, "grant has no allowed_paths — fail closed"
    # attempt/cost limits must be explicit numbers
    if not int(auth.get("attempts_per_task") or 0) >= 1:
        return False, "grant has no attempts_per_task limit"
    if not float(auth.get("max_cost_usd") or
                 auth.get("max_tokens") or 0) > 0:
        return False, "grant has no cost/token limit"
    return True, ""


def failing_checks(task: dict) -> list[dict]:
    return [c for c in (task.get("evidence") or {}).get("checks", [])
            if not c.get("ok")]


def classify(task: dict) -> dict:
    """Root-cause guess with confidence — from the REAL check output,
    not vibes. Returns {category, confidence, detail, repairable}."""
    fails = failing_checks(task)
    tail = " ".join(str(c.get("tail") or c.get("error") or
                        c.get("detail") or "") for c in fails)[:2000]
    if not fails:
        return {"category": "unknown", "confidence": "low",
                "detail": "no failing check recorded",
                "repairable": False}
    if re.search(r"(not found|No such file|ModuleNotFound|cannot open)",
                 tail, re.I):
        return {"category": "missing_file_or_data", "confidence": "high",
                "detail": tail[:300], "repairable": True}
    if re.search(r"(permission|denied|access)", tail, re.I):
        return {"category": "permission_or_tool", "confidence": "high",
                "detail": tail[:300], "repairable": False}
    if _ASSERT_RE.search(tail):
        return {"category": "wrong_implementation", "confidence": "medium",
                "detail": tail[:400], "repairable": True}
    return {"category": "unclear_failure", "confidence": "low",
            "detail": tail[:300], "repairable": True}


def _paths_from(task: dict) -> list[str]:
    """Verified file paths from acceptance + prompt mentions — the
    corrective task gets exact paths, not guesses."""
    found = set()
    for c in task.get("acceptance") or []:
        for k in ("path",):
            if c.get(k):
                found.add(str(c[k]).replace("\\", "/"))
        if c.get("cmd"):
            found.update(m.replace("\\", "/")
                         for m in _PATH_RE.findall(str(c["cmd"])))
        for a in c.get("args") or []:
            found.update(m.replace("\\", "/")
                         for m in _PATH_RE.findall(str(a)))
    for m in _PATH_RE.findall(task.get("prompt", "") or ""):
        found.add(m.replace("\\", "/"))
    for f in (task.get("evidence") or {}).get("produced_files") or []:
        found.add(str(f).replace("\\", "/"))
    return sorted(p for p in found
                  if p.casefold() not in FORBIDDEN_PATHS
                  and "/" in p)


def plan_recovery(coord, task_id: str) -> dict:
    """Detect+diagnose a FAILED task and persist an RCA record. Does
    NOT dispatch — returns the decision for tick()/CLI."""
    t = coord.get_task(task_id)
    if not t or t.get("status") != "FAILED":
        return {"ok": False, "reason": f"{task_id} not FAILED"}
    rec = t.get("recovery") or {}
    attempts = int(rec.get("attempts", 0))
    path = coord.root / STATE_FILE
    d = _load(path)
    rid = rec.get("id") or hashlib.sha256(
        f"RCV|{task_id}|{t.get('prompt_sha','')}".encode()).hexdigest()[:10]
    cls = classify(t)
    rca = {"id": rid, "task_id": task_id, "diagnosed_at": utcnow(),
           "category": cls["category"], "confidence": cls["confidence"],
           "repairable": cls["repairable"], "detail": cls["detail"],
           "failing_checks": [str(c.get("check")) for c in
                              failing_checks(t)][:10],
           "paths": _paths_from(t), "attempts": attempts}
    d["recoveries"][rid] = {**rca, "state": "DIAGNOSED"}
    _save(path, d)
    return {"ok": True, "rca": rca, "recorded": rid}


def maybe_spawn_recovery(coord, task_id: str, notifier=None) -> dict:
    """If a FAILED task qualifies, create+approve+dispatch ONE bounded
    corrective task — inside its own authorized worktree only, re-using
    the ORIGINAL acceptance checks for re-verification."""
    t = coord.get_task(task_id)
    if not t or t.get("status") != "FAILED":
        return {"spawned": False, "reason": "not FAILED"}
    if t.get("scope") != "production":
        return {"spawned": False, "reason": "test-scope never recovers"}
    rec = t.get("recovery") or {}
    if rec.get("state") in ("ESCALATED", "WAITING_HUMAN",
                            "COOLDOWN", "RECOVERY_DISPATCHED"):
        return {"spawned": False, "reason": f"recovery {rec['state']}"}
    attempts = int(rec.get("attempts", 0))
    if attempts >= MAX_RECOVERY_ATTEMPTS:
        def _es(x):
            r = dict(x.get("recovery") or {})
            r["state"] = "ESCALATED"
            x["recovery"] = r
        coord._mutate(task_id, _es)
        return {"spawned": False, "reason": "recovery attempts exhausted",
                "escalate": True}
    if rec.get("child_id") and coord.get_task(rec["child_id"]).get(
            "status") in ("PENDING", "READY", "DISPATCHED", "RUNNING",
                          "VERIFYING", "NEEDS_APPROVAL"):
        return {"spawned": False, "reason": "recovery already in flight",
                "child": rec["child_id"]}
    # --- program boundary: parent's own authorization must exist ---
    auth = _auth_for(coord, t["worktree"])
    wt = str(Path(t["worktree"]).resolve()).casefold()
    def _wait(reason):
        def _m(x):
            r = dict(x.get("recovery") or {})
            r.update({"state": "WAITING_HUMAN", "wait_reason": reason})
            x["recovery"] = r
        coord._mutate(task_id, _m)
        return {"spawned": False, "reason": reason,
                "waiting_human": True}
    if wt not in set(getattr(coord, "authorized_worktrees", []) or []):
        return _wait("worktree not in authorized_worktrees")
    rca = plan_recovery(coord, task_id)
    if not rca.get("ok"):
        return {"spawned": False, "reason": rca.get("reason")}
    cls = rca["rca"]
    if not cls["repairable"]:
        return _wait(cls["category"])
    gok, greason = check_grant(auth, t, cls)
    if not gok:
        return _wait(f"grant rejected: {greason}")

    rid = cls["id"]
    child_id = f"RCV-{task_id}-{attempts + 1}"
    fails = failing_checks(t)
    fail_txt = "\n".join(f"- {c.get('check')}: "
                         f"{(c.get('tail') or c.get('error') or '')[:400]}"
                         for c in fails)[:1600]
    paths = "\n".join(f"  {p}" for p in cls["paths"]) or "  (none recorded)"
    prompt = (
        f"RECOVERY {rid}: the previous task '{t.get('title','')}' FAILED "
        f"its acceptance checks.\n\nDiagnosis ({cls['category']}, "
        f"{cls['confidence']} confidence):\n{cls['detail'][:400]}\n\n"
        f"Failing checks:\n{fail_txt}\n\nRelevant files:\n{paths}\n\n"
        "Fix the ROOT CAUSE so the original acceptance checks pass. "
        "Do NOT weaken or edit the tests to force them green; do not "
        "change expected values without evidence. Keep changes minimal "
        "and inside this repository.")
    prompt += ("\nForbidden files — never edit: "
               "DB/forever/quest.lua, DB/forever/xp.lua.")
    if t.get("repair_directive"):
        prompt += (f"\n\nDiagnosed repair hint (verify before applying): "
                   f"{t['repair_directive']}")
    res = coord.add_task(
        child_id, f"Recover {task_id} ({cls['category']})",
        prompt, t["worktree"], priority=int(t.get("priority", 50)) - 5,
        acceptance=list(t.get("acceptance") or []),  # SAME checks
        approved=True, scope="production",
        owner="recovery", generated_by="recovery",
        reason=f"RCA {rid}: {cls['category']} "
               f"({cls['confidence']})",
        evidence_refs=[f"rca:{rid}", f"task:{task_id}"],
        max_attempts=1)
    if not res.get("added"):
        return {"spawned": False, "reason": res.get("reason")}
    coord._mutate(child_id, lambda x: x.__setitem__(
        "recovers", task_id))
    if attempts > 0:
        # cooldown between attempts — a matured tick dispatches it
        coord._mutate(child_id, lambda x: x.__setitem__(
            "not_before", time.time() + RECOVERY_COOLDOWN_S))
        def _mark(x):
            r = dict(x.get("recovery") or {})
            r.update({"id": rid, "attempts": attempts + 1,
                      "child_id": child_id, "state": "COOLDOWN"})
            x["recovery"] = r
        coord._mutate(task_id, _mark)
        st = _load(coord.root / STATE_FILE)
        st["recoveries"].setdefault(rid, {}).update(
            {"state": "COOLDOWN", "child": child_id})
        _save(coord.root / STATE_FILE, st)
        coord._event("recovery_scheduled", task_id=task_id,
                     child=child_id, cooldown_s=RECOVERY_COOLDOWN_S)
        return {"spawned": False, "scheduled": child_id,
                "cooldown_s": RECOVERY_COOLDOWN_S}
    # mark parent
    def _mark(x):
        r = dict(x.get("recovery") or {})
        r.update({"id": rid, "attempts": attempts + 1,
                  "child_id": child_id, "state": "RECOVERY_DISPATCHED"})
        x["recovery"] = r
    coord._mutate(task_id, _mark)
    disp = coord.dispatch(child_id)
    st = _load(coord.root / STATE_FILE)
    st["recoveries"].setdefault(rid, {}).update(
        {"state": "RECOVERY_DISPATCHED", "child": child_id,
         "dispatched": bool(disp.get("dispatched"))})
    _save(coord.root / STATE_FILE, st)
    coord._event("recovery_dispatched", task_id=task_id, child=child_id,
                 rca=rid, category=cls["category"],
                 dispatched=bool(disp.get("dispatched")))
    return {"spawned": bool(disp.get("dispatched")), "child": child_id,
            "rca": rca["rca"], "dispatch": disp}


def on_child_done(coord, child: dict) -> None:
    """After a recovery child reaches COMPLETE/FAILED, update the
    parent's supersession state. COMPLETE means the ORIGINAL checks
    re-ran green (they are the child's acceptance)."""
    parent_id = child.get("recovers")
    if not parent_id:
        return
    st = coord.get_task(parent_id)
    if not st or st.get("status") != "FAILED":
        return
    rca_id = (st.get("recovery") or {}).get("id", "")
    if child["status"] == "COMPLETE":
        coord._transition(parent_id, "VERIFIED_RECOVERED",
                          reason=f"recovery {child['id']} re-passed "
                                 "original acceptance")
        state = "VERIFIED_RECOVERED"
        coord._event("verified_recovered", task_id=parent_id,
                     child=child["id"])
    elif child["status"] == "FAILED":
        # RETRY_FAILED lets the NEXT tick spawn the second (final)
        # attempt — the attempt cap in maybe_spawn_recovery turns it
        # ESCALATED once MAX_RECOVERY_ATTEMPTS is reached.
        def _esc(x):
            r = dict(x.get("recovery") or {})
            r["state"] = "RETRY_FAILED"
            x["recovery"] = r
        coord._mutate(parent_id, _esc)
        state = "RETRY_FAILED"
        coord._event("recovery_child_failed", task_id=parent_id,
                     child=child["id"])
    else:
        return
    path = coord.root / STATE_FILE
    d = _load(path)
    if rca_id in d["recoveries"]:
        d["recoveries"][rca_id]["state"] = state
        _save(path, d)


def tick(coord, notifier=None) -> dict:
    """Daemon step: find FAILED production tasks that can be recovered
    inside their own grants; escalate exhausted ones once."""
    acted = []
    for t in coord.list_tasks():
        if t.get("scope") != "production":
            continue
        # supersession resolution for finished children
        rec = t.get("recovery") or {}
        cid = rec.get("child_id")
        if cid:
            c = coord.get_task(cid)
            if c and c.get("status") in ("COMPLETE", "FAILED"):
                on_child_done(coord, c)
        t = coord.get_task(t["id"]) or t   # may have just transitioned
        # matured cooldown children get dispatched here
        cid = (t.get("recovery") or {}).get("child_id")
        if cid:
            c = coord.get_task(cid)
            if (c and c.get("status") in ("READY", "PENDING")
                    and float(c.get("not_before") or 0) <= time.time()):
                d = coord.dispatch(cid)
                if d.get("dispatched"):
                    acted.append(f"recovery dispatched {cid}")
                    st = _load(coord.root / STATE_FILE)
                    rid = (t.get("recovery") or {}).get("id", "")
                    if rid in st["recoveries"]:
                        st["recoveries"][rid]["state"] = \
                            "RECOVERY_DISPATCHED"
                        _save(coord.root / STATE_FILE, st)
        if t.get("status") != "FAILED":
            continue
        if (t.get("recovery") or {}).get("state") in (
                "ESCALATED", "WAITING_HUMAN"):
            continue
        if (t.get("recovery") or {}).get("state") in (
                "RECOVERY_DISPATCHED", "COOLDOWN"):
            continue
        if t.get("recovers"):
            continue  # a failed corrective escalates its parent only
        res = maybe_spawn_recovery(coord, t["id"], notifier)
        if res.get("spawned"):
            acted.append(f"recovery {t['id']} -> {res['child']}")
        elif res.get("escalate"):
            if notifier:
                notifier.task_failed(
                    f"Recovery exhausted: {t['title'][:60]}",
                    f"task {t['id']} failed {t.get('recovery',{}).get('attempts')} repairs",
                    "human decision required")
            acted.append(f"escalated {t['id']}")
        elif res.get("waiting_human"):
            acted.append(f"waiting_human {t['id']}: {res.get('reason')}")
    return {"acted": acted}
