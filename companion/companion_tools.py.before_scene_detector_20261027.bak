 def learn_czech():
  import goal_workflow
  result=goal_workflow._language_audit()
  path=write_artifact(out,'czech_command_baseline.json',json.dumps(result,ensure_ascii=False,indent=2))
  if result['failure_count']==0:store.remember('skill:czech_command_routing','Ověřené české příkazy web/media; '+str(result['total'])+' zkoušek. Zdroj '+path['path'],'verified_exercise')
  return {**result,'report':path,'verified':path['verified'],'scope':'Baseline of Czech command recognition; not general Czech fluency. Failures remain open.'}
 register('learn_czech','Proveď měřitelnou zkoušku porozumění českým příkazům a ulož konkrétní chyby. Neprohlašuj tím plynulou češtinu.',{},learn_czech,write=True)
