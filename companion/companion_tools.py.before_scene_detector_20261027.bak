  data=study(goal);return {**data,'reply':format_study(data),'verified':True}
 register('project_study','Prostuduj skutečné soubory a moduly ForeverRoute a vrať doložený přehled.',{'goal':text_schema(950)},project_study)
 register('project_read','Přečti vybrané řádky Lua nebo dokumentace projektu. Chráněná DB a tajné soubory nejsou přístupné.',{'path':text_schema(250),'start':{'type':'integer','minimum':1},'lines':{'type':'integer','minimum':1,'maximum':200}},lambda path,start=1,lines=100:{**read_project(settings.REPO,path,start,lines),'verified':True},required=['path'])
 def knowledge_search(query):
  import knowledge
  hits=knowledge.search(query,limit=5);return {'results':hits,'verified':True,'found':bool(hits)}
 register('knowledge_search','Hledej v místních znalostech, vrať úryvky a zdrojové soubory.',{'query':text_schema(250)},knowledge_search)
 def memory_save(key,value):
  if PRIVATE.search(key+' '+value):raise ToolError('sensitive_memory_rejected')
  store.remember(key,value,'user_request');return {'key':key,'verified':any(m['key']==key and m['value']==value for m in store.memories(key,100))}
 register('memory_save','Ulož výslovnou uživatelskou preferenci nebo poznámku. Nenahrazuj fakta domněnkami.',{'key':text_schema(120),'value':text_schema(5000)},memory_save,write=True)
 def memory_search(query):
  from knowledge_store import NoteStore
  notes=NoteStore(settings.BASE/'user_notes.sqlite').search(query)
  return {'memories':store.memories(query),'legacy_notes':notes,'past_messages':store.search_history(cid,query),'verified':True}
 register('memory_search','Vybav uložené preference a poznámky, včetně starší paměti.',{'query':{'type':'string','maxLength':500}},memory_search)
 def learning_status():
  from companion_learning import status
  return {**status(settings),'verified':True}
 register('learning_status','Přečti uložené výsledky výuky a skutečně ověřené postupy tohoto buildu.',{},learning_status)
 register('memory_forget','Odstraň konkrétní paměť na výslovné přání uživatele.',{'key':text_schema(120)},lambda key:{'removed':store.forget(key),'verified':not any(m['key']==key for m in store.memories(key,100))},write=True)
 register('artifact_write','Vytvoř textový výstup v soukromé složce tohoto úkolu a ověř jeho obsah.',{'name':text_schema(150),'content':text_schema(20000)},lambda name,content:write_artifact(out,name,content),write=True)
