"""Durable conversations, task ownership, evidence and idempotency for one companion."""
from __future__ import annotations
import json,sqlite3,time,uuid,hashlib
from pathlib import Path
from contextlib import contextmanager

TERMINAL={'VERIFIED','ANSWERED','PARTIAL','FAILED','CANCELLED','NEEDS_REVIEW'}
class UncertainWrite(RuntimeError):pass
def packed(value):return json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(',',':'))

class Store:
 def __init__(self,path):
  self.path=Path(path);self.path.parent.mkdir(parents=True,exist_ok=True)
  with self.db() as cx:
   cx.executescript('''
    CREATE TABLE IF NOT EXISTS conversations(id TEXT PRIMARY KEY,client_key TEXT UNIQUE,created REAL);
    CREATE TABLE IF NOT EXISTS tasks(id TEXT PRIMARY KEY,conversation_id TEXT,request_key TEXT,goal TEXT,status TEXT,answer TEXT DEFAULT '',created REAL,updated REAL,owner TEXT,lease_until REAL DEFAULT 0,state TEXT DEFAULT '{}',pending TEXT,UNIQUE(conversation_id,request_key));
    CREATE TABLE IF NOT EXISTS messages(seq INTEGER PRIMARY KEY,conversation_id TEXT,task_id TEXT,role TEXT,content TEXT,at REAL,UNIQUE(task_id,role));
    CREATE TABLE IF NOT EXISTS events(seq INTEGER PRIMARY KEY,task_id TEXT,kind TEXT,body TEXT,at REAL);
    CREATE TABLE IF NOT EXISTS calls(task_id TEXT,call_id TEXT,name TEXT,args TEXT,is_write INTEGER,status TEXT,result TEXT,updated REAL,PRIMARY KEY(task_id,call_id));
    CREATE TABLE IF NOT EXISTS approvals(task_id TEXT,signature TEXT,at REAL,PRIMARY KEY(task_id,signature));
    CREATE TABLE IF NOT EXISTS memories(key TEXT PRIMARY KEY,value TEXT,origin TEXT,updated REAL);
    CREATE TABLE IF NOT EXISTS schedules(id TEXT PRIMARY KEY,conversation_id TEXT,goal TEXT,next_run REAL,interval_seconds REAL,enabled INTEGER DEFAULT 1);
    CREATE TABLE IF NOT EXISTS service_leases(name TEXT PRIMARY KEY,owner TEXT,expires REAL);
    CREATE INDEX IF NOT EXISTS tasks_queue ON tasks(status,created);
    CREATE INDEX IF NOT EXISTS messages_conversation ON messages(conversation_id,seq);
    CREATE INDEX IF NOT EXISTS events_task ON events(task_id,seq);
   ''')
   if 'attempts' not in {x[1] for x in cx.execute('PRAGMA table_info(tasks)')}:cx.execute('ALTER TABLE tasks ADD COLUMN attempts INTEGER DEFAULT 0')
 @contextmanager
 def db(self):
  cx=sqlite3.connect(self.path,timeout=15);cx.row_factory=sqlite3.Row
  cx.execute('PRAGMA busy_timeout=15000')
  try:yield cx;cx.commit()
  except BaseException:cx.rollback();raise
  finally:cx.close()
 def _event(self,cx,task_id,kind,body):
  cx.execute('INSERT INTO events(task_id,kind,body,at) VALUES(?,?,?,?)',(task_id,kind,packed(body),time.time()))
 def conversation(self,client_key):
  if not isinstance(client_key,str) or not 1<=len(client_key)<=200:raise ValueError('invalid_client_key')
  with self.db() as cx:
   cx.execute('INSERT OR IGNORE INTO conversations VALUES(?,?,?)',(str(uuid.uuid4()),client_key,time.time()))
   return cx.execute('SELECT id FROM conversations WHERE client_key=?',(client_key,)).fetchone()[0]
 def _submit(self,cx,conversation_id,goal,request_key):
  if not isinstance(goal,str) or not 1<=len(goal.strip())<=6000:raise ValueError('invalid_goal')
  if not isinstance(request_key,str) or not 1<=len(request_key)<=200:raise ValueError('invalid_request_key')
  if not cx.execute('SELECT 1 FROM conversations WHERE id=?',(conversation_id,)).fetchone():raise KeyError('conversation')
  old=cx.execute('SELECT * FROM tasks WHERE conversation_id=? AND request_key=?',(conversation_id,request_key)).fetchone()
  if old:
   if old['goal']!=goal.strip():raise ValueError('request_key_reused_for_different_goal')
   return dict(old)
  id=str(uuid.uuid4());now=time.time()
  cx.execute('INSERT INTO tasks(id,conversation_id,request_key,goal,status,created,updated) VALUES(?,?,?,?,?,?,?)',(id,conversation_id,request_key,goal.strip(),'QUEUED',now,now))
  cx.execute('INSERT INTO messages(conversation_id,task_id,role,content,at) VALUES(?,?,?,?,?)',(conversation_id,id,'user',goal.strip(),now))
  self._event(cx,id,'accepted',{'goal':goal.strip()})
  return dict(cx.execute('SELECT * FROM tasks WHERE id=?',(id,)).fetchone())
 def submit(self,conversation_id,goal,request_key=None):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');return self._submit(cx,conversation_id,goal,request_key or str(uuid.uuid4()))
 def get(self,id):
  with self.db() as cx:row=cx.execute('SELECT * FROM tasks WHERE id=?',(id,)).fetchone()
  if row is None:raise KeyError(id)
  result=dict(row);result['state']=json.loads(result['state']);result['pending']=json.loads(result['pending']) if result['pending'] else None
  return result
 def tasks(self,conversation_id,limit=30):
  with self.db() as cx:rows=cx.execute('SELECT id FROM tasks WHERE conversation_id=? ORDER BY created DESC LIMIT ?',(conversation_id,max(1,min(limit,100)))).fetchall()
  return [self.get(x[0]) for x in rows]
 def history(self,conversation_id,limit=80):
  with self.db() as cx:rows=cx.execute('SELECT role,content,task_id,seq FROM messages WHERE conversation_id=? ORDER BY seq DESC LIMIT ?',(conversation_id,max(1,min(limit,500)))).fetchall()
  return [dict(x) for x in reversed(rows)]
 def history_after(self,conversation_id,after,limit=100):
  with self.db() as cx:rows=cx.execute('SELECT role,content,task_id,seq FROM messages WHERE conversation_id=? AND seq>? ORDER BY seq LIMIT ?',(conversation_id,after,limit)).fetchall()
  return [dict(x) for x in rows]
 def history_through(self,conversation_id,task_id,limit=16):
  with self.db() as cx:
   current=cx.execute("SELECT seq FROM messages WHERE conversation_id=? AND task_id=? AND role='user'",(conversation_id,task_id)).fetchone()
   if not current:raise KeyError(task_id)
   rows=cx.execute('SELECT role,content,task_id,seq FROM messages WHERE conversation_id=? AND seq<? ORDER BY seq DESC LIMIT ?',(conversation_id,current[0],limit)).fetchall()
  return [dict(x) for x in reversed(rows)]
 def search_history(self,conversation_id,query,limit=6):
  terms=[x.casefold() for x in query.split() if len(x)>2]
  with self.db() as cx:rows=cx.execute('SELECT role,content,task_id,seq FROM messages WHERE conversation_id=? ORDER BY seq DESC LIMIT 2000',(conversation_id,)).fetchall()
  results=[dict(x) for x in rows if not terms or any(term in x['content'].casefold() for term in terms)]
  return [{**x,'content':x['content'][:4000]} for x in results[:limit]]
 def claim(self,owner,lease_seconds=60):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');row=cx.execute("SELECT id FROM tasks WHERE status='QUEUED' ORDER BY created LIMIT 1").fetchone()
   if not row:return None
   token=owner+':'+uuid.uuid4().hex
   cx.execute("UPDATE tasks SET status='RUNNING',owner=?,lease_until=?,updated=?,attempts=attempts+1 WHERE id=?",(token,time.time()+lease_seconds,time.time(),row[0]))
   self._event(cx,row[0],'running',{'owner':owner})
  return self.get(row[0])
 def heartbeat(self,id,owner,seconds=60):
  with self.db() as cx:cx.execute("UPDATE tasks SET lease_until=?,updated=? WHERE id=? AND owner=? AND status='RUNNING'",(time.time()+seconds,time.time(),id,owner))
 def _fence(self,cx,id,token):
  if token is None:return # Trusted local maintenance; job execution always supplies its immutable token.
  row=cx.execute('SELECT status,owner,lease_until FROM tasks WHERE id=?',(id,)).fetchone()
  if not row or row['status']!='RUNNING' or row['owner']!=token or row['lease_until']<time.time():raise InterruptedError('execution_lease_lost')
 def checkpoint(self,id,state,token=None):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');self._fence(cx,id,token)
   cx.execute("UPDATE tasks SET state=?,updated=? WHERE id=? AND status='RUNNING'",(packed(state),time.time(),id))
 def event(self,id,kind,body):
  with self.db() as cx:self._event(cx,id,kind,body)
 def events(self,id,after=0):
  with self.db() as cx:rows=cx.execute('SELECT * FROM events WHERE task_id=? AND seq>? ORDER BY seq LIMIT 100',(id,after)).fetchall()
  return [{**dict(x),'body':json.loads(x['body'])} for x in rows]
 def finish(self,id,status,answer,token=None):
  if status not in TERMINAL:raise ValueError('not_terminal')
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');self._fence(cx,id,token);row=cx.execute('SELECT status,conversation_id FROM tasks WHERE id=?',(id,)).fetchone()
   if not row:raise KeyError(id)
   if row['status'] in TERMINAL or row['status']=='WAITING_APPROVAL':return False
   cx.execute('UPDATE tasks SET status=?,answer=?,lease_until=0,updated=? WHERE id=?',(status,answer[:30000],time.time(),id))
   state=json.loads(cx.execute('SELECT state FROM tasks WHERE id=?',(id,)).fetchone()[0]);message_id=id+(':resume:'+str(state['resume_round']) if state.get('resume_round') else '')
   cx.execute('INSERT OR IGNORE INTO messages(conversation_id,task_id,role,content,at) VALUES(?,?,?,?,?)',(row['conversation_id'],message_id,'assistant',answer[:30000],time.time()))
   self._event(cx,id,'finished',{'status':status,'answer':answer[:30000]});return True
 def cancel(self,id):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');row=cx.execute('SELECT status FROM tasks WHERE id=?',(id,)).fetchone()
   if not row:raise KeyError(id)
   if row[0] not in TERMINAL:
    cx.execute("UPDATE tasks SET status='CANCELLED',answer='Úkol byl zastaven.',updated=? WHERE id=?",(time.time(),id));self._event(cx,id,'cancelled',{})
  return self.get(id)
 def begin_tool(self,id,call_id,name,args,is_write,token=None):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');self._fence(cx,id,token)
   if cx.execute('SELECT status FROM tasks WHERE id=?',(id,)).fetchone()[0]!='RUNNING':raise RuntimeError('task_not_running')
   if is_write:
    previous=cx.execute("SELECT * FROM calls WHERE task_id=? AND name=? AND args=? AND is_write=1 ORDER BY updated DESC LIMIT 1",(id,name,packed(args))).fetchone()
    if previous and previous['status']=='COMPLETE':return json.loads(previous['result'])
    if previous and previous['call_id']!=call_id:raise UncertainWrite('equivalent_write_outcome_unknown')
   old=cx.execute('SELECT * FROM calls WHERE task_id=? AND call_id=?',(id,call_id)).fetchone()
   if old:
    if old['name']!=name or old['args']!=packed(args):raise ValueError('call_identity_mismatch')
    if old['status']=='COMPLETE':return json.loads(old['result'])
    if old['is_write']:raise UncertainWrite('write_outcome_unknown')
   else:cx.execute('INSERT INTO calls VALUES(?,?,?,?,?,?,?,?)',(id,call_id,name,packed(args),int(is_write),'STARTED',None,time.time()))
   self._event(cx,id,'tool_started',{'name':name,'call_id':call_id});return None
 def complete_tool(self,id,call_id,result,token=None):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');self._fence(cx,id,token)
   cx.execute("UPDATE calls SET status='COMPLETE',result=?,updated=? WHERE task_id=? AND call_id=?",(packed(result),time.time(),id,call_id))
   self._event(cx,id,'tool_completed',{'call_id':call_id,'ok':result.get('ok',False)})
 def tool_results(self,id):
  with self.db() as cx:rows=cx.execute('SELECT * FROM calls WHERE task_id=? ORDER BY updated',(id,)).fetchall()
  return [{**dict(x),'args':json.loads(x['args']),'result':json.loads(x['result']) if x['result'] else None} for x in rows]
 def recover(self):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');rows=cx.execute("SELECT id,attempts,conversation_id FROM tasks WHERE status='RUNNING' AND lease_until<?",(time.time(),)).fetchall()
   for row in rows:
    uncertain=cx.execute("SELECT 1 FROM calls WHERE task_id=? AND is_write=1 AND status='STARTED'",(row[0],)).fetchone()
    status='NEEDS_REVIEW' if uncertain else 'FAILED' if row['attempts']>=3 else 'QUEUED'
    answer='Výsledek rozpracovaného zápisu vyžaduje kontrolu.' if uncertain else 'Úloha byla třikrát přerušena. Průběh zůstává uložený.' if status=='FAILED' else ''
    cx.execute('UPDATE tasks SET status=?,answer=?,owner=NULL,lease_until=0,updated=? WHERE id=?',(status,answer,time.time(),row[0]));self._event(cx,row[0],'recovered',{'status':status})
    if status in TERMINAL:cx.execute('INSERT OR IGNORE INTO messages(conversation_id,task_id,role,content,at) VALUES(?,?,?,?,?)',(row['conversation_id'],row[0],'assistant',answer,time.time()))
   return len(rows)
 def _signature(self,call_id,name,args):return hashlib.sha256(packed([call_id,name,args]).encode()).hexdigest()
 def wait_approval(self,id,call,token=None):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');self._fence(cx,id,token)
   cx.execute("UPDATE tasks SET status='WAITING_APPROVAL',pending=?,lease_until=0,updated=? WHERE id=? AND status='RUNNING'",(packed(call),time.time(),id))
   self._event(cx,id,'approval_required',call)
 def approve(self,id):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');row=cx.execute("SELECT pending FROM tasks WHERE id=? AND status='WAITING_APPROVAL'",(id,)).fetchone()
   if not row:raise ValueError('not_waiting_approval')
   call=json.loads(row[0]);sig=self._signature(call['id'],call['name'],call['arguments'])
   cx.execute('INSERT OR IGNORE INTO approvals VALUES(?,?,?)',(id,sig,time.time()))
   cx.execute("UPDATE tasks SET status='QUEUED',updated=? WHERE id=?",(time.time(),id));self._event(cx,id,'approved',{'signature':sig})
  return self.get(id)
 def activate_approved(self,id,token):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE')
   return cx.execute("UPDATE tasks SET status='RUNNING',lease_until=?,updated=? WHERE id=? AND owner=? AND status='QUEUED' AND pending IS NOT NULL",(time.time()+30,time.time(),id,token)).rowcount==1
 def resume(self,id):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');row=cx.execute('SELECT * FROM tasks WHERE id=?',(id,)).fetchone()
   if not row or row['status'] not in ('PARTIAL','FAILED'):raise ValueError('task_cannot_resume_automatically')
   if cx.execute("SELECT 1 FROM calls WHERE task_id=? AND is_write=1 AND status='STARTED'",(id,)).fetchone():raise UncertainWrite('write_requires_review')
   state=json.loads(row['state']);state.pop('direct',None);state.pop('budget_exhausted',None);state.pop('answer',None)
   state.update({'resumed':True,'resume_round':state.get('resume_round',0)+1,'steps':0,'phase':'decide','failed_tools':False,'had_tools':False})
   state.setdefault('messages',[]).append({'role':'user','content':'Pokračuj v rozpracované práci. Použij uložené výsledky; neopakuj dokončené zápisy. Zaměř se na zbývající krok.'})
   cx.execute("UPDATE tasks SET status='QUEUED',state=?,attempts=0,updated=? WHERE id=?",(packed(state),time.time(),id))
   self._event(cx,id,'resumed',{'round':state['resume_round']})
  return self.get(id)
 def approved(self,id,call_id,name,args):
  with self.db() as cx:return bool(cx.execute('SELECT 1 FROM approvals WHERE task_id=? AND signature=?',(id,self._signature(call_id,name,args))).fetchone())
 def remember(self,key,value,origin='user'):
  if not isinstance(key,str) or not 1<=len(key)<=120 or not isinstance(value,str) or not 1<=len(value)<=5000:raise ValueError('invalid_memory')
  with self.db() as cx:cx.execute('INSERT INTO memories VALUES(?,?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,origin=excluded.origin,updated=excluded.updated',(key,value,origin,time.time()))
 def memories(self,query='',limit=20):
  with self.db() as cx:rows=cx.execute('SELECT * FROM memories ORDER BY updated DESC LIMIT 500').fetchall()
  terms=set(query.casefold().split())
  results=[dict(x) for x in rows if not terms or any(t in (x['key']+' '+x['value']).casefold() for t in terms)]
  return results[:limit]
 def forget(self,key):
  with self.db() as cx:return cx.execute('DELETE FROM memories WHERE key=?',(key,)).rowcount==1
 def schedule(self,conversation_id,goal,next_run,interval_seconds=0):
  if interval_seconds and interval_seconds<60:raise ValueError('minimum_interval_60_seconds')
  if not isinstance(next_run,(int,float)) or next_run>time.time()+366*86400:raise ValueError('invalid_schedule_time')
  if not isinstance(goal,str) or not 1<=len(goal)<=6000:raise ValueError('invalid_goal')
  id=str(uuid.uuid4())
  with self.db() as cx:cx.execute('INSERT INTO schedules VALUES(?,?,?,?,?,1)',(id,conversation_id,goal,next_run,interval_seconds))
  return {'id':id,'next_run':next_run,'interval_seconds':interval_seconds}
 def schedules(self,conversation_id):
  with self.db() as cx:return [dict(x) for x in cx.execute('SELECT * FROM schedules WHERE conversation_id=? ORDER BY next_run',(conversation_id,))]
 def pause_schedule(self,id,conversation_id):
  with self.db() as cx:return cx.execute('UPDATE schedules SET enabled=0 WHERE id=? AND conversation_id=?',(id,conversation_id)).rowcount==1
 def tick(self):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');now=time.time();rows=cx.execute('SELECT * FROM schedules WHERE enabled=1 AND next_run<=?',(now,)).fetchall()
   for row in rows:
    self._submit(cx,row['conversation_id'],row['goal'],'schedule:'+row['id']+':'+str(row['next_run']))
    interval=row['interval_seconds']
    next_run=row['next_run']+(int((now-row['next_run'])/interval)+1)*interval if interval else row['next_run']
    cx.execute('UPDATE schedules SET next_run=?,enabled=? WHERE id=?',(next_run,int(bool(interval)),row['id']))
   return len(rows)
 def service_lease(self,name,owner,seconds=15):
  with self.db() as cx:
   cx.execute('BEGIN IMMEDIATE');row=cx.execute('SELECT * FROM service_leases WHERE name=?',(name,)).fetchone()
   if row and row['owner']!=owner and row['expires']>time.time():return False
   cx.execute('INSERT OR REPLACE INTO service_leases VALUES(?,?,?)',(name,owner,time.time()+seconds));return True
 def service_status(self,name):
  with self.db() as cx:row=cx.execute('SELECT * FROM service_leases WHERE name=?',(name,)).fetchone()
  return {**dict(row),'alive':row['expires']>time.time()} if row else {'alive':False}
